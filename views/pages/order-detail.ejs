<div id="app" data-order-id="<%= orderId %>" data-payment-result="<%= paymentResult %>">
  <div class="max-w-[1440px] mx-auto px-6 md:px-16 py-12">
    <div class="flex flex-col gap-2 mb-8">
      <h1 class="font-serif text-3xl font-bold text-accent-gold-light">訂單詳情</h1>
    </div>

    <div v-if="loading" class="flex justify-center py-24">
      <div class="spinner"></div>
    </div>

    <template v-else-if="order">
      <!-- Payment Alert -->
      <div
        v-if="paymentResult && paymentMessages[paymentResult]"
        class="card-elevated px-6 py-4 mb-7 text-sm tracking-wide"
        :class="paymentMessages[paymentResult].cls"
      >
        {{ paymentMessages[paymentResult].text }}
      </div>

      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Left Column -->
        <div class="flex-1 flex flex-col gap-6">
          <!-- Order Info -->
          <div class="bg-bg-surface border border-border-subtle p-7 flex items-start justify-between">
            <div class="flex flex-col gap-2">
              <p class="text-text-secondary text-sm">訂單編號：{{ order.order_no }}</p>
              <p class="text-text-muted text-xs">建立日期：{{ new Date(order.created_at).toLocaleDateString('zh-TW') }}</p>
            </div>
            <span :class="statusMap[order.status]?.cls || 'status-badge-pending'">
              {{ statusMap[order.status]?.label || order.status }}
            </span>
          </div>

          <!-- Recipient -->
          <div class="bg-bg-surface border border-border-subtle p-7 flex flex-col gap-4">
            <h2 class="text-text-primary text-base font-medium">收件資訊</h2>
            <div class="flex gap-3 text-sm">
              <span class="text-text-muted w-16 flex-shrink-0">收件人</span>
              <span class="text-text-secondary">{{ order.recipient_name }}</span>
            </div>
            <div class="flex gap-3 text-sm">
              <span class="text-text-muted w-16 flex-shrink-0">Email</span>
              <span class="text-text-secondary">{{ order.recipient_email }}</span>
            </div>
            <div class="flex gap-3 text-sm">
              <span class="text-text-muted w-16 flex-shrink-0">地址</span>
              <span class="text-text-secondary">{{ order.recipient_address }}</span>
            </div>
          </div>

          <!-- Items -->
          <div class="bg-bg-surface border border-border-subtle p-7 flex flex-col gap-5">
            <h2 class="text-text-primary text-base font-medium">商品明細</h2>
            <div class="flex justify-between text-xs text-text-muted pb-2 border-b border-border-gold">
              <span>商品名稱</span>
              <div class="flex gap-8">
                <span class="w-16 text-right">單價</span>
                <span class="w-10 text-right">數量</span>
                <span class="w-20 text-right">小計</span>
              </div>
            </div>
            <div
              v-for="item in order.items"
              :key="item.id"
              class="flex justify-between text-sm py-3"
            >
              <span class="text-text-primary">{{ item.product_name }}</span>
              <div class="flex gap-8 text-text-secondary">
                <span class="w-16 text-right">NT$ {{ item.product_price.toLocaleString() }}</span>
                <span class="w-10 text-right">{{ item.quantity }}</span>
                <span class="w-20 text-right text-text-primary font-medium">NT$ {{ (item.product_price * item.quantity).toLocaleString() }}</span>
              </div>
            </div>
            <div class="flex justify-end gap-4 pt-4 border-t border-border-gold">
              <span class="text-text-primary font-bold">總計</span>
              <span class="text-accent-rose-light text-lg font-bold">NT$ {{ order.total_amount.toLocaleString() }}</span>
            </div>
          </div>
        </div>

        <!-- Right Column -->
        <div class="lg:w-[360px] flex-shrink-0 flex flex-col gap-5">
          <div class="overflow-hidden border border-border-gold">
            <img
              src="https://images.unsplash.com/photo-1615182787503-08365d1e7fae?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w4NDM0ODN8MHwxfHJhbmRvbXx8fHx8fHx8fDE3ODI4OTEyODJ8&ixlib=rb-4.1.0&q=80&w=720"
              alt="花束"
              class="w-full h-[400px] object-cover"
            />
          </div>
          <button
            v-if="order.status === 'pending'"
            @click="goToEcpay"
            :disabled="paying"
            class="btn-primary w-full"
          >
            {{ paying ? '處理中...' : '前往綠界付款' }}
          </button>
        </div>
      </div>
    </template>
  </div>
</div>
