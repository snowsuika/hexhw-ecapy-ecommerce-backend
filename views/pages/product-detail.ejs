<div id="app" data-product-id="<%= productId %>">
  <div v-if="loading" class="flex justify-center py-24">
    <div class="spinner"></div>
  </div>

  <div v-else-if="notFound" class="text-center py-24 px-6">
    <h2 class="font-serif text-2xl text-accent-gold-light mb-3">找不到此商品</h2>
    <a href="/" class="text-accent-gold-light hover:text-text-primary text-sm transition-colors">回到首頁</a>
  </div>

  <div v-else-if="product" class="flex flex-col lg:flex-row max-w-[1440px] mx-auto">
    <!-- Image Column -->
    <div class="lg:w-1/2">
      <div class="border border-border-gold overflow-hidden">
        <img
          :src="product.image_url || 'https://images.unsplash.com/photo-1620142828449-203a4979d9c3?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1080'"
          :alt="product.name"
          class="w-full aspect-square object-cover"
        />
      </div>
    </div>

    <!-- Info Column -->
    <div class="lg:w-1/2 bg-bg-surface border-l border-border-gold flex flex-col gap-7 p-10 md:p-14 md:pl-14">
      <h1 class="font-serif text-3xl font-bold text-accent-gold-light">{{ product.name }}</h1>
      <p class="text-2xl font-bold text-accent-gold-light">NT$ {{ product.price.toLocaleString() }}</p>
      <div class="gold-line w-12"></div>
      <p class="text-text-secondary text-sm leading-relaxed">{{ product.description }}</p>

      <div class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-accent-gold"></span>
        <span class="text-stock text-sm">✓ 尚有 {{ product.stock }} 件</span>
      </div>

      <div class="flex items-center gap-5">
        <span class="text-text-muted text-sm">數量</span>
        <div class="qty-control">
          <button @click="decrease">-</button>
          <span>{{ quantity }}</span>
          <button @click="increase">+</button>
        </div>
      </div>

      <button
        @click="addToCart"
        :disabled="adding || product.stock <= 0"
        class="btn-primary w-full"
      >
        {{ product.stock <= 0 ? '已售完' : '加入購物車' }}
      </button>

      <div class="card-elevated p-6 flex flex-col gap-2.5">
        <h3 class="text-text-primary text-sm font-medium">購買須知</h3>
        <p class="text-text-muted text-xs">- 花材依據季節供應，實際花束可能略有差異</p>
        <p class="text-text-muted text-xs">- 台北市區可享當日配送服務</p>
        <p class="text-text-muted text-xs">- 消費滿 NT$ 500 享免運優惠</p>
      </div>
    </div>
  </div>
</div>
