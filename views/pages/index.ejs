<div id="app">
  <!-- Hero -->
  <section id="hero" class="relative h-[min(680px,85vh)] overflow-hidden">
    <img
      src="https://images.unsplash.com/photo-1602280798662-f6a856e18a98?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w4NDM0ODN8MHwxfHJhbmRvbXx8fHx8fHx8fDE3ODI4OTEyNzl8&ixlib=rb-4.1.0&q=80&w=1440"
      alt="花束"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-bg-base/90 via-bg-base/60 to-transparent"></div>
    <div class="relative h-full max-w-[1440px] mx-auto flex flex-col justify-end px-6 md:px-20 pb-16 md:pb-20 gap-5">
      <div class="gold-line w-14"></div>
      <h1 class="font-serif text-4xl md:text-5xl font-bold text-white drop-shadow-lg max-w-2xl leading-tight">
        讓花裝點生活每一刻
      </h1>
      <p class="text-text-secondary text-sm md:text-base leading-relaxed max-w-lg drop-shadow">
        精選當季鮮花，由專業花藝師手工包裝。每一束花都傳遞著溫暖與祝福，為您的生活增添色彩與芬芳。
      </p>
      <a href="#products" class="btn-primary w-fit">立即選購</a>
    </div>
  </section>

  <!-- Featured Products -->
  <section id="featured-products" class="bg-bg-surface py-16 md:py-22 px-6 md:px-18">
    <div class="max-w-[1440px] mx-auto">
      <div class="flex flex-col gap-3 mb-12">
        <h2 class="font-serif text-3xl md:text-4xl font-bold text-accent-gold-light">精選推薦</h2>
        <p class="text-accent-gold-muted text-sm tracking-widest">本季最受歡迎的花卉精選</p>
        <div class="gold-line w-10 mt-1"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 justify-items-center">
        <div
          v-for="(product, idx) in products.slice(0, 4)"
          :key="product.id"
          class="card-elevated w-full max-w-[300px] overflow-hidden cursor-pointer group"
          @click="goToProduct(product.id)"
        >
          <div class="aspect-[300/380] overflow-hidden">
            <img
              :src="product.image_url || featuredImages[idx % 4]"
              :alt="product.name"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="p-5 flex flex-col gap-3">
            <h3 class="font-serif text-lg text-accent-gold-light truncate">{{ product.name }}</h3>
            <p class="font-serif text-xl font-bold text-accent-gold-light">NT$ {{ product.price.toLocaleString() }}</p>
            <button
              @click.stop="addToCart(product)"
              :disabled="product._adding || product.stock <= 0"
              class="w-full py-3 text-sm font-medium text-white bg-accent-rose-light border border-border-gold-strong hover:bg-accent-rose transition-colors disabled:opacity-50"
            >
              {{ product.stock <= 0 ? '已售完' : '加入購物車' }}
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Brand Story -->
  <section id="brand-story" class="border-y border-border-gold overflow-hidden">
    <div class="flex flex-col md:flex-row max-w-[1440px] mx-auto">
      <div class="md:w-1/2 h-64 md:h-[520px] overflow-hidden">
        <img
          id="brand-story-img"
          src="https://images.unsplash.com/photo-1615182787503-08365d1e7fae?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w4NDM0ODN8MHwxfHJhbmRvbXx8fHx8fHx8fDE3ODI4OTEyODJ8&ixlib=rb-4.1.0&q=80&w=720"
          alt="花藝師"
          class="w-full h-full object-cover border-l-2 border-accent-gold scale-110"
        />
      </div>
      <div class="md:w-1/2 bg-gradient-to-r from-bg-surface to-bg-elevated flex flex-col justify-center gap-6 p-10 md:p-16 md:pl-18">
        <div class="gold-line w-16"></div>
        <h2 class="font-serif text-2xl md:text-3xl font-bold text-accent-gold-light leading-snug">
          專心，做好一束花的感動
        </h2>
        <p class="text-text-secondary text-sm leading-relaxed">
          花漾生活成立於 2020 年，我們相信每一朵花都有自己的故事。透過專業花藝師的巧手，將大自然的美好帶進您的日常生活中。
        </p>
        <p class="font-serif text-accent-gold-muted text-sm italic">
          「每一束花，都是一份用心的禮物。」
        </p>
      </div>
    </div>
  </section>

  <!-- All Products -->
  <section id="products" class="py-16 md:py-20 px-6 md:px-16">
    <div class="max-w-[1440px] mx-auto">
      <div class="flex flex-col items-center gap-2 mb-12 text-center">
        <h2 class="font-serif text-3xl md:text-4xl font-bold text-accent-gold-light">探索所有花藝</h2>
        <p class="text-accent-gold-muted text-sm tracking-widest">找到屬於您的那束花</p>
        <div class="gold-line w-10 mt-2"></div>
      </div>

      <div v-if="loading" class="flex justify-center py-16">
        <div class="spinner"></div>
      </div>

      <template v-else>
        <div v-if="products.length === 0" class="text-center py-16">
          <p class="text-text-secondary">目前沒有商品</p>
          <p class="text-text-muted text-sm mt-1">請稍後再來看看</p>
        </div>

        <div v-else class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8 justify-items-center">
          <div
            v-for="product in products"
            :key="product.id"
            class="card-elevated w-full max-w-[300px] overflow-hidden cursor-pointer group"
            @click="goToProduct(product.id)"
          >
            <div class="aspect-[300/380] overflow-hidden">
              <img
                :src="product.image_url || 'https://images.unsplash.com/photo-1620142828449-203a4979d9c3?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1080'"
                :alt="product.name"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-5 flex flex-col gap-3">
              <h3 class="font-serif text-lg text-accent-gold-light truncate">{{ product.name }}</h3>
              <p class="font-serif text-xl font-bold text-accent-gold-light">NT$ {{ product.price.toLocaleString() }}</p>
              <button
                @click.stop="addToCart(product)"
                :disabled="product._adding || product.stock <= 0"
                class="w-full py-3 text-sm font-medium text-white bg-accent-rose-light border border-border-gold-strong hover:bg-accent-rose transition-colors disabled:opacity-50"
              >
                {{ product.stock <= 0 ? '已售完' : '加入購物車' }}
              </button>
            </div>
          </div>
        </div>

        <div v-if="pagination.totalPages > 1" class="flex justify-center gap-2 mt-12">
          <button
            v-for="p in pagination.totalPages"
            :key="p"
            @click="loadProducts(p)"
            class="w-10 h-10 text-sm transition-colors border"
            :class="p === pagination.page ? 'bg-accent-rose-light text-white border-border-gold-strong' : 'bg-bg-elevated text-text-secondary border-border-gold hover:border-accent-gold'"
          >
            {{ p }}
          </button>
        </div>
      </template>
    </div>
  </section>

  <!-- Testimonials -->
  <section id="testimonials" class="bg-bg-base py-16 md:py-22 px-6 md:px-18">
    <div class="max-w-[1440px] mx-auto">
      <h2 class="font-serif text-3xl font-bold text-accent-gold-light text-center mb-12">顧客花束好評分享</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <div class="card-elevated p-7 flex flex-col gap-5">
          <p class="text-accent-gold-muted">★★★★★</p>
          <p class="text-text-secondary text-sm italic leading-relaxed">「花束非常漂亮，包裝精緻，送給媽媽她超開心的！配送也很準時。」</p>
          <p class="text-text-muted text-xs tracking-wide">-- 小美</p>
        </div>
        <div class="card-elevated p-7 flex flex-col gap-5">
          <p class="text-accent-gold-muted">★★★★★</p>
          <p class="text-text-secondary text-sm italic leading-relaxed">「第二次購買了，品質一如既往的好。花材新鮮，整體搭配很有美感。」</p>
          <p class="text-text-muted text-xs tracking-wide">-- 阿明</p>
        </div>
        <div class="card-elevated p-7 flex flex-col gap-5">
          <p class="text-accent-gold-muted">★★★★★</p>
          <p class="text-text-secondary text-sm italic leading-relaxed">「女朋友收到花束超感動！會再回購的，推薦給大家！」</p>
          <p class="text-text-muted text-xs tracking-wide">-- 大衛</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="grid grid-cols-1 md:grid-cols-3 max-w-[1440px] mx-auto px-6 md:px-18 pb-20 md:pb-22">
    <div class="bg-bg-surface border border-border-gold md:border-r-0 flex flex-col items-center gap-3 py-12 px-8 text-center">
      <svg class="w-7 h-7 text-accent-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/></svg>
      <h3 class="font-serif text-lg text-accent-gold-light">快速配送</h3>
      <p class="text-text-muted text-sm">台北市區當日配送</p>
    </div>
    <div class="bg-bg-surface border border-border-gold md:border-r-0 flex flex-col items-center gap-3 py-12 px-8 text-center">
      <svg class="w-7 h-7 text-accent-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/></svg>
      <h3 class="font-serif text-lg text-accent-gold-light">精美包裝</h3>
      <p class="text-text-muted text-sm">每束花都經過精心包裝</p>
    </div>
    <div class="bg-bg-surface border border-accent-gold flex flex-col items-center gap-3 py-12 px-8 text-center">
      <svg class="w-7 h-7 text-accent-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
      <h3 class="font-serif text-lg text-accent-gold-light">滿額免運</h3>
      <p class="text-text-muted text-sm">消費滿 NT$ 500 免運費</p>
    </div>
  </section>
</div>
