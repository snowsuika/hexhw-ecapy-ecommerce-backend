<div id="app">
  <div class="flex flex-col lg:flex-row min-h-[560px]">
    <!-- Left: Image Panel -->
    <div class="hidden lg:block lg:w-1/2 relative overflow-hidden border-r border-border-gold">
      <img
        src="https://images.unsplash.com/photo-1602280798662-f6a856e18a98?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w4NDM0ODN8MHwxfHJhbmRvbXx8fHx8fHx8fDE3ODI4OTEyNzl8&ixlib=rb-4.1.0&q=80&w=1440"
        alt="花束"
        class="absolute inset-0 w-full h-full object-cover"
      />
    </div>

    <!-- Right: Login Form -->
    <div class="flex-1 bg-bg-surface border-l border-border-gold flex items-center justify-center p-8 md:p-16 lg:p-20">
      <div class="card-elevated w-full max-w-[380px] p-9 flex flex-col gap-7">
        <h1 class="font-serif text-2xl font-bold text-accent-gold text-center">花漾生活</h1>

        <!-- Tabs -->
        <div class="flex border-b border-border-gold">
          <button
            @click="activeTab = 'login'; errors = {}"
            class="flex-1 py-3 text-sm font-medium transition-colors border-b-2"
            :class="activeTab === 'login' ? 'text-text-primary border-accent-gold' : 'text-text-muted border-transparent hover:text-text-secondary'"
          >
            登入
          </button>
          <button
            @click="activeTab = 'register'; errors = {}"
            class="flex-1 py-3 text-sm font-medium transition-colors border-b-2"
            :class="activeTab === 'register' ? 'text-text-primary border-accent-gold' : 'text-text-muted border-transparent hover:text-text-secondary'"
          >
            註冊
          </button>
        </div>

        <!-- Login Form -->
        <form v-if="activeTab === 'login'" @submit.prevent="handleLogin" class="flex flex-col gap-5">
          <div class="flex flex-col gap-2">
            <label class="text-text-muted text-xs tracking-widest">Email</label>
            <input
              v-model="loginForm.email"
              type="email"
              placeholder="請輸入 Email"
              class="input-dark"
              :class="{ 'border-accent-rose-light': errors.email }"
            />
            <p v-if="errors.email" class="text-accent-rose-light text-xs">{{ errors.email }}</p>
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-text-muted text-xs tracking-widest">密碼</label>
            <input
              v-model="loginForm.password"
              type="password"
              placeholder="請輸入密碼"
              class="input-dark"
              :class="{ 'border-accent-rose-light': errors.password }"
            />
            <p v-if="errors.password" class="text-accent-rose-light text-xs">{{ errors.password }}</p>
          </div>
          <button type="submit" :disabled="submitting" class="btn-primary w-full">
            {{ submitting ? '登入中...' : '登入' }}
          </button>
        </form>

        <!-- Register Form -->
        <form v-else @submit.prevent="handleRegister" class="flex flex-col gap-5">
          <div class="flex flex-col gap-2">
            <label class="text-text-muted text-xs tracking-widest">姓名</label>
            <input
              v-model="registerForm.name"
              type="text"
              placeholder="請輸入姓名"
              class="input-dark"
              :class="{ 'border-accent-rose-light': errors.name }"
            />
            <p v-if="errors.name" class="text-accent-rose-light text-xs">{{ errors.name }}</p>
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-text-muted text-xs tracking-widest">Email</label>
            <input
              v-model="registerForm.email"
              type="email"
              placeholder="請輸入 Email"
              class="input-dark"
              :class="{ 'border-accent-rose-light': errors.email }"
            />
            <p v-if="errors.email" class="text-accent-rose-light text-xs">{{ errors.email }}</p>
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-text-muted text-xs tracking-widest">密碼</label>
            <input
              v-model="registerForm.password"
              type="password"
              placeholder="至少 6 個字元"
              class="input-dark"
              :class="{ 'border-accent-rose-light': errors.password }"
            />
            <p v-if="errors.password" class="text-accent-rose-light text-xs">{{ errors.password }}</p>
          </div>
          <button type="submit" :disabled="submitting" class="btn-primary w-full">
            {{ submitting ? '註冊中...' : '註冊' }}
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
