<div id="app">
  <div class="max-w-[1440px] mx-auto px-6 md:px-16 py-12">
    <div class="flex flex-col gap-2 mb-8">
      <h1 class="font-serif text-3xl font-bold text-text-primary">購物車</h1>
    </div>

    <div v-if="loading" class="flex justify-center py-24">
      <div class="spinner"></div>
    </div>

    <div v-else-if="items.length === 0" class="text-center py-24">
      <p class="text-text-secondary mb-1">購物車是空的</p>
      <p class="text-text-muted text-sm mb-6">快去挑選喜歡的花束吧！</p>
      <a href="/" class="btn-primary">去逛逛</a>
    </div>

    <template v-else>
      <div class="flex flex-col lg:flex-row gap-12">
        <!-- Left: Items -->
        <div class="flex-1 flex flex-col gap-8">
          <div v-if="total < 500" class="card-elevated px-6 py-3.5 text-sm text-accent-gold-light text-center tracking-wide">
            再買 NT$ {{ (500 - total).toLocaleString() }} 即可享免運費！
          </div>
          <div v-else class="card-elevated px-6 py-3.5 text-sm text-accent-gold-light text-center tracking-wide">
            ✓ 已達免運門檻！
          </div>

          <div class="border border-border-gold">
            <div
              v-for="item in items"
              :key="item.id"
              class="flex items-center gap-6 p-6 md:p-7 border-b border-border-subtle last:border-0"
            >
              <img
                :src="item.product.image_url || 'https://images.unsplash.com/photo-1620142828449-203a4979d9c3?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1080'"
                :alt="item.product.name"
                class="w-[88px] h-[88px] object-cover flex-shrink-0"
              />
              <div class="flex-1 min-w-0 flex flex-col gap-1.5">
                <h3 class="text-text-primary text-sm font-medium truncate">{{ item.product.name }}</h3>
                <p class="text-accent-gold-light text-sm">NT$ {{ item.product.price.toLocaleString() }}</p>
              </div>

              <div class="qty-control flex-shrink-0">
                <button
                  @click="updateQuantity(item.id, item.quantity - 1)"
                  :disabled="item.quantity <= 1"
                >-</button>
                <span>{{ item.quantity }}</span>
                <button
                  @click="updateQuantity(item.id, item.quantity + 1)"
                  :disabled="item.quantity >= item.product.stock"
                >+</button>
              </div>

              <p class="text-text-primary text-sm font-medium w-24 text-right flex-shrink-0">
                NT$ {{ (item.product.price * item.quantity).toLocaleString() }}
              </p>

              <button
                @click="confirmDelete(item.id)"
                class="text-text-muted hover:text-accent-rose-light transition-colors text-sm flex-shrink-0"
              >✕</button>
            </div>
          </div>
        </div>

        <!-- Right: Summary -->
        <div class="lg:w-[400px] flex-shrink-0">
          <div class="card-elevated p-8 flex flex-col gap-5 sticky top-28">
            <h2 class="text-text-primary text-base font-medium">訂單摘要</h2>
            <div class="flex justify-between text-sm">
              <span class="text-text-secondary">商品小計</span>
              <span class="text-text-primary">NT$ {{ total.toLocaleString() }}</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-text-secondary">運費</span>
              <span class="text-text-primary">{{ total >= 500 ? '免運' : 'NT$ 150' }}</span>
            </div>
            <div class="h-px bg-border-gold"></div>
            <div class="flex justify-between items-center">
              <span class="text-text-primary font-bold">總計</span>
              <span class="text-accent-rose-light text-xl font-bold">
                NT$ {{ (total + (total >= 500 ? 0 : 150)).toLocaleString() }}
              </span>
            </div>
            <button @click="goCheckout" class="btn-primary w-full">前往結帳</button>
          </div>
        </div>
      </div>
    </template>
  </div>

  <!-- Confirm Dialog -->
  <div v-if="confirmVisible" class="fixed inset-0 z-50 flex items-center justify-center">
    <div class="absolute inset-0 bg-black/60" @click="confirmVisible = false"></div>
    <div class="relative card-elevated w-full max-w-sm mx-4 p-8 text-center">
      <h3 class="font-serif text-lg text-text-primary mb-2">確認移除</h3>
      <p class="text-text-secondary text-sm mb-6">確定要從購物車中移除這個商品嗎？</p>
      <div class="flex gap-3 justify-center">
        <button @click="confirmVisible = false" class="px-5 py-2 text-sm border border-border-gold text-text-secondary hover:bg-bg-muted transition-colors">取消</button>
        <button @click="handleDelete" class="px-5 py-2 text-sm bg-accent-rose-light text-white border border-border-gold-strong hover:bg-accent-rose transition-colors">確認移除</button>
      </div>
    </div>
  </div>
</div>
