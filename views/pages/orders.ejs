<div id="app">
  <div class="max-w-[1440px] mx-auto px-6 md:px-16 py-12">
    <div class="flex flex-col gap-2 mb-8">
      <h1 class="font-serif text-3xl font-bold text-accent-gold-light">我的訂單</h1>
    </div>

    <div v-if="loading" class="flex justify-center py-24">
      <div class="spinner"></div>
    </div>

    <div v-else-if="orders.length === 0" class="text-center py-24">
      <p class="text-text-secondary mb-1">尚無訂單</p>
      <p class="text-text-muted text-sm mb-6">快去選購喜歡的花束吧！</p>
      <a href="/" class="btn-primary">去逛逛</a>
    </div>

    <div v-else class="flex flex-col gap-8">
      <a
        v-for="order in orders"
        :key="order.id"
        :href="'/orders/' + order.id"
        class="card-elevated flex items-center gap-6 p-7 hover:border-accent-gold transition-colors"
      >
        <img
          src="https://images.unsplash.com/photo-1692167900605-e02666cadb6d?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1080"
          alt=""
          class="w-[72px] h-[72px] object-cover flex-shrink-0"
        />
        <div class="flex-1 min-w-0 flex flex-col gap-1.5">
          <p class="text-text-secondary text-sm tracking-wide">訂單編號：{{ order.order_no }}</p>
          <p class="text-text-muted text-xs">{{ new Date(order.created_at).toLocaleDateString('zh-TW') }}</p>
        </div>
        <div class="flex items-center gap-5 flex-shrink-0">
          <span class="text-accent-gold font-bold italic">NT$ {{ order.total_amount.toLocaleString() }}</span>
          <span :class="statusMap[order.status]?.cls || 'status-badge-pending'">
            {{ statusMap[order.status]?.label || order.status }}
          </span>
          <span class="text-text-muted text-lg">→</span>
        </div>
      </a>
    </div>
  </div>
</div>
